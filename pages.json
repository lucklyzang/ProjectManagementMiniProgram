{
	"easycom": {
		"^u-(.*)": "uview-ui/components/u-$1/u-$1.vue"
	},
	"lazyCodeLoading": "requiredComponents",
	"pages": [
		{
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "",
				"navigationBarBackgroundColor": "#75b0f0",
				"navigationBarTextStyle": "black",
				"navigationStyle" : "custom"
			}
		},
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "",
				"navigationBarBackgroundColor": "#75b0f0",
				"navigationBarTextStyle": "black",
				"navigationStyle" : "custom"
			}
		},
		{
			"path": "pages/personInfo/personInfo",
			"style": { 
				"navigationBarTitleText": "",
				"navigationBarBackgroundColor": "#75b0f0",
				"navigationBarTextStyle": "black",
				"navigationStyle" : "custom"
			}
		}
	],
	"subPackages": [
		{
			"root": "projectManagementPackage",
			"name": "rootProjectManagementPackage",
			"pages": [
				{
					"path": "pages/RepairsWorkOrder/RepairsWorkOrder",
					"style": {
						"navigationBarTitleText": "",
						"navigationBarBackgroundColor": "#ffffff",
						"backgroundColorTop": "#fff,",
						"backgroundColorBottom": "#fff",
						"navigationStyle" : "custom"
					}
				},
				{
					"path": "pages/RepairsWorkOrder/WorkOrderCheck",
					"style": {
						"navigationBarTitleText": "",
						"navigationBarBackgroundColor": "#ffffff",
						"backgroundColorTop": "#fff,",
						"backgroundColorBottom": "#fff",
						"navigationStyle" : "custom"
					}
				}
			]
		}
	],
	"preloadRule": {
		"projectManagementPackage/pages/RepairsWorkOrder/RepairsWorkOrder": {
				"network": "all",
				"packages": ["rootProjectManagementPackage"]
		}
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"tabBar":{
	"color":"#666666",
	"selectedColor":"#1684FC",
	"backgroundColor":"#fff",
	"borderStyle":"white",
	"list":[
			{
				"pagePath":"pages/index/index",
				"text":"主页",
				"iconPath":"static/img/index.png",
				"selectedIconPath":"static/img/index-current.png"
			},
			{
				"pagePath":"pages/personInfo/personInfo",
				"text":"我的",
				"iconPath":"static/img/my.png",
				"selectedIconPath":"static/img/my-current.png"
			}
		]
	},
	"uniIdRouter": {},
	"condition" : { //模式配置，仅开发期间生效
		"current": 0, //当前激活的模式(list 的索引项)
		"list": [
			{
				"name": "", //模式名称
				"path": "", //启动页面，必选
				"query": "" //启动参数，在页面的onLoad函数里面得到
			}
		]
	}
}
